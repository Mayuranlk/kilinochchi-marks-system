rules_version = '2';

// REVIEW ONLY — NOT REFERENCED BY firebase.json AND NOT DEPLOYED.
// This is an interim compatibility ruleset. Academic reads remain broad where
// current React pages still issue whole-collection queries. Class/subject read
// scope must be tightened only with the reconciled scoped-query rollout.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function role() {
      return hasProfile() ? profile().get('role', '') : '';
    }

    function isAdmin() {
      return hasProfile() && role() in ['admin', 'Admin', 'ADMIN'];
    }

    function isAccount() {
      return hasProfile() && role() in ['account', 'Account', 'ACCOUNT'];
    }

    function isPrefect() {
      return hasProfile() && (
        role() in ['prefect', 'Prefect', 'PREFECT'] ||
        profile().get('isPrefect', false) == true
      );
    }

    function isSectionalHead() {
      return hasProfile() && (
        role() in ['sectional_head', 'Sectional_Head', 'SECTIONAL_HEAD'] ||
        profile().get('isSectionalHead', false) == true
      );
    }

    function isITTeacher() {
      return hasProfile() && (
        role() in ['it_teacher', 'IT_Teacher', 'IT_TEACHER'] ||
        profile().get('isITTeacher', false) == true ||
        profile().get('canAccessAllReports', false) == true
      );
    }

    function isSubjectTeacher() {
      return hasProfile() && (
        role() in ['teacher', 'Teacher', 'TEACHER'] ||
        isITTeacher() ||
        profile().get('isSubjectTeacher', false) == true
      );
    }

    function isAcademicReader() {
      return isAdmin() || isSubjectTeacher() || isSectionalHead();
    }

    function validOptionalAttendance(data) {
      return !data.keys().hasAny(['attendancePercentage']) ||
        data.attendancePercentage == null ||
        (data.attendancePercentage is number &&
          data.attendancePercentage >= 0 && data.attendancePercentage <= 100);
    }

    function validMarkAliases(data) {
      return data.mark == data.marks &&
        data.mark == data.score &&
        data.absent == data.isAbsent;
    }

    function validMarkValue(data) {
      return (data.absent == true && data.mark == null) ||
        (data.absent == false && (
          data.mark == null ||
          (data.mark is number && data.mark >= 0 && data.mark <= 100)
        ));
    }

    function validCanonicalMark(data) {
      return data.keys().hasAll([
          'schemaVersion', 'studentId', 'subjectId', 'academicYearKey', 'termKey',
          'gradeNumber', 'classKey', 'subjectKey', 'assessmentKey',
          'markKey', 'mark', 'marks', 'score', 'absent', 'isAbsent',
          'teacherId'
        ]) &&
        data.schemaVersion == 2 &&
        data.studentId is string && data.studentId.size() > 0 &&
        data.subjectId is string && data.subjectId.size() > 0 &&
        data.academicYearKey is string && data.academicYearKey.size() > 0 &&
        data.termKey is string && data.termKey.size() > 0 &&
        data.gradeNumber is number &&
        data.classKey is string && data.classKey.size() > 0 &&
        data.subjectKey is string && data.subjectKey.size() > 0 &&
        data.assessmentKey is string && data.assessmentKey.size() > 0 &&
        data.markKey is string && data.markKey.size() > 0 &&
        data.absent is bool && data.isAbsent is bool &&
        data.teacherId is string && data.teacherId == request.auth.uid &&
        validMarkAliases(data) &&
        validMarkValue(data) &&
        validOptionalAttendance(data);
    }

    function teacherPreservesMarkIdentity() {
      return request.resource.data.studentId == resource.data.studentId &&
        (!resource.data.keys().hasAny(['markKey']) ||
          request.resource.data.markKey == resource.data.markKey);
    }

    function validLateArrivalCreate(data) {
      return data.keys().hasAll([
          'studentId', 'dateKey', 'arrivalTime', 'reason',
          'recordBookReceived', 'bookStatus', 'recordedBy',
          'recordedAt', 'handoverHistory'
        ]) &&
        data.keys().hasOnly([
          'studentId', 'studentName', 'admissionNo', 'grade', 'section',
          'classLabel', 'dateKey', 'arrivalTime', 'reason',
          'recordBookReceived', 'bookStatus', 'recordedBy',
          'recordedAt', 'handoverHistory'
        ]) &&
        data.studentId is string && data.studentId.size() > 0 &&
        data.dateKey is string && data.dateKey.size() > 0 &&
        data.arrivalTime is timestamp &&
        data.reason is string &&
        data.recordBookReceived is bool &&
        data.bookStatus in ['held', 'not_received'] &&
        data.recordedBy is map &&
        data.recordedBy.get('uid', '') == request.auth.uid &&
        data.recordedAt is timestamp &&
        data.handoverHistory is list;
    }

    function validLateArrivalReturnUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'bookStatus', 'returnedAt', 'handedOverBy', 'handoverHistory'
      ]) &&
        request.resource.data.bookStatus == 'returned' &&
        request.resource.data.returnedAt is timestamp &&
        request.resource.data.handedOverBy is map &&
        request.resource.data.handedOverBy.get('uid', '') == request.auth.uid &&
        request.resource.data.handoverHistory is list;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAcademicReader());
      // Teacher Dashboard and current admin tools still list users. Account and
      // prefect sessions need only their own profile document.
      allow list: if isAcademicReader();
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAcademicReader() || isAccount() || isPrefect();
      allow create, update, delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isAcademicReader();
      allow create, update, delete: if isAdmin();
    }

    match /classrooms/{classroomId} {
      allow read: if isAcademicReader();
      allow create, update, delete: if isAdmin();
    }

    match /academicTerms/{termId} {
      allow read: if isAcademicReader();
      allow create, update, delete: if isAdmin();
    }

    match /practiceExams/{examId} {
      allow read: if isAcademicReader();
      allow create, update, delete: if isAdmin();
    }

    match /teacherAssignments/{assignmentId} {
      allow read: if isAcademicReader();
      allow create, update, delete: if isAdmin();
    }

    match /studentSubjectEnrollments/{enrollmentId} {
      allow read: if isAcademicReader();
      allow create, update, delete: if isAdmin();
    }

    // Optional prerequisite: SBA remains a read-only reference for term writes.
    // The UI checks the whole roster; rules independently require each saved
    // student's corresponding SBA result, even for direct client writes.
    function hasCompletedSba(data) {
      let termId = data.get('academicTermId', '');
      let term = get(/databases/$(database)/documents/academicTerms/$(termId)).data;
      let id = termId + '~' + data.studentId + '~' + data.subjectId;
      let sba = get(/databases/$(database)/documents/sbaMarks/$(id)).data;
      return string(term.get('academicYear', term.get('year', ''))) == data.academicYearKey &&
        term.get('term', term.get('termName', term.get('name', ''))) == data.get('term', '') &&
        sba.termId == termId && sba.studentId == data.studentId && sba.subjectId == data.subjectId &&
        sba.year == data.academicYearKey && sba.classKey == sbaClassKey(data) &&
        ((sba.absent == true && sba.mark == null) ||
          (sba.absent == false && sba.mark is number && sba.mark >= 0 && sba.mark <= 20));
    }

    function termSbaPrerequisite(data) {
      let path = /databases/$(database)/documents/systemSettings/marksEntry;
      return !exists(path) || get(path).data.get('requireSbaCompletion', false) != true ||
        data.get('assessmentType', 'term') == 'practice' ||
        data.get('term', '').lower().matches('.*practice.*') || hasCompletedSba(data);
    }

    match /marks/{markId} {
      allow read: if isAcademicReader();
      allow create: if isAdmin() || (isSubjectTeacher() && validCanonicalMark(request.resource.data) && termSbaPrerequisite(request.resource.data));
      allow update: if isAdmin() || (
        isSubjectTeacher() &&
        validCanonicalMark(request.resource.data) &&
        termSbaPrerequisite(request.resource.data) &&
        teacherPreservesMarkIdentity()
      );
      allow delete: if isAdmin();
    }

    // SBA is a separate assessment store. No SBA operation grants access to marks.
    function sbaClassKey(data) {
      return string(int(data.grade)) + '|' + data.section.upper() + '|' +
        (int(data.grade) >= 12 ? data.get('stream', '').lower() : '');
    }

    function sbaOpen() {
      let path = /databases/$(database)/documents/systemSettings/sbaEntry;
      return !exists(path) || (get(path).data.get('teacherEntryEnabled', true) == true &&
        (get(path).data.get('teacherEntryDeadlineAt', null) == null ||
          request.time <= get(path).data.teacherEntryDeadlineAt));
    }

    function validSbaShape(data, markId) {
      return data.keys().hasAll(['schemaVersion', 'assessmentType', 'maxMark',
          'termId', 'year', 'classKey', 'scopeKey', 'subjectId', 'studentId',
          'assignmentId', 'enrollmentId', 'mark', 'absent', 'revision', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['schemaVersion', 'assessmentType', 'maxMark',
          'termId', 'year', 'classKey', 'scopeKey', 'subjectId', 'studentId',
          'assignmentId', 'enrollmentId', 'mark', 'absent', 'revision', 'updatedBy', 'updatedAt']) &&
        data.schemaVersion == 1 && data.assessmentType == 'sba' && data.maxMark == 20 &&
        data.termId is string && data.termId.size() > 0 && !data.termId.matches('.*[~/].*') &&
        data.studentId is string && data.studentId.size() > 0 && !data.studentId.matches('.*[~/].*') &&
        data.subjectId is string && data.subjectId.size() > 0 && !data.subjectId.matches('.*[~/].*') &&
        markId == data.termId + '~' + data.studentId + '~' + data.subjectId &&
        data.year is string && data.classKey is string &&
        data.scopeKey == data.termId + '|' + data.classKey &&
        data.assignmentId is string && data.enrollmentId is string &&
        data.updatedBy is string && data.updatedAt is timestamp &&
        data.revision is int && data.revision > 0 && data.absent is bool &&
        ((data.absent && data.mark == null) || (!data.absent &&
          (data.mark == null || (data.mark is number && data.mark >= 0 && data.mark <= 20))));
    }

    function sbaAssigned(data) {
      let assignment = get(/databases/$(database)/documents/teacherAssignments/$(data.assignmentId)).data;
      let enrollment = get(/databases/$(database)/documents/studentSubjectEnrollments/$(data.enrollmentId)).data;
      let term = get(/databases/$(database)/documents/academicTerms/$(data.termId)).data;
      let student = get(/databases/$(database)/documents/students/$(data.studentId)).data;
      return (
          assignment.get('teacherId', assignment.get('teacherUid', assignment.get('userId', ''))) == request.auth.uid ||
          (request.auth.token.get('email', '') != '' &&
            assignment.get('teacherEmail', assignment.get('email', '')).lower() == request.auth.token.email.lower())
        ) && assignment.get('status', 'active').lower() == 'active' &&
        enrollment.get('status', 'active').lower() == 'active' &&
        student.get('status', 'active').lower() == 'active' &&
        assignment.subjectId == data.subjectId && enrollment.subjectId == data.subjectId &&
        enrollment.studentId == data.studentId &&
        string(enrollment.get('academicYear', enrollment.get('year', ''))) == data.year &&
        string(term.get('academicYear', term.get('year', ''))) == data.year &&
        (assignment.get('academicYear', assignment.get('year', '')) == '' ||
          string(assignment.get('academicYear', assignment.get('year', ''))) == data.year) &&
        term.get('assessmentType', 'term') != 'practice' &&
        !term.get('term', term.get('termName', term.get('name', ''))).lower().matches('.*practice.*') &&
        sbaClassKey(assignment) == data.classKey && sbaClassKey(enrollment) == data.classKey &&
        (assignment.get('medium', assignment.get('teachingMedium', '')) == '' ||
          assignment.get('medium', assignment.get('teachingMedium', '')).lower() ==
            enrollment.get('medium', student.get('medium', '')).lower()) &&
        data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }

    match /sbaMarks/{markId} {
      allow read: if isAcademicReader();
      allow create: if validSbaShape(request.resource.data, markId) && (isAdmin() ||
        (isSubjectTeacher() && sbaOpen() && request.resource.data.revision == 1 && sbaAssigned(request.resource.data)));
      allow update: if validSbaShape(request.resource.data, markId) && (isAdmin() ||
        (isSubjectTeacher() && sbaOpen() && sbaAssigned(request.resource.data) &&
          request.resource.data.revision == resource.data.revision + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'mark', 'absent', 'revision', 'updatedBy', 'updatedAt', 'assignmentId', 'enrollmentId'
          ])));
      allow delete: if isAdmin();
    }

    match /systemSettings/{settingId} {
      allow read: if isAcademicReader();
      allow create, update, delete: if isAdmin();
    }

    match /studentFeeAccounts/{accountId} {
      allow read, create, update: if isAdmin() || isAccount();
      allow delete: if isAdmin();
    }

    match /lateArrivalRecords/{recordId} {
      allow read: if isAdmin() || isPrefect();
      allow create: if isAdmin() || (isPrefect() && validLateArrivalCreate(request.resource.data));
      allow update: if isAdmin() || (isPrefect() && validLateArrivalReturnUpdate());
      allow delete: if isAdmin();
    }

    match /elections/{electionId} {
      // Deployed Rules already require authentication; preserve that behavior.
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      // Backup/restore writes exact historical audit documents, so admin must
      // retain full access until restore is moved to a trusted backend.
      allow read, create, update, delete: if isAdmin();
    }

    match /classShufflePlans/{planId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /promotionHistory/{historyId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
